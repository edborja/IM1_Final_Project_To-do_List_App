# Flask Secret Key
SECRET_KEY=your-secret-key-here

# Database Configuration
# Format: mysql+pymysql://username:password@localhost:3306/database_name
DATABASE_URL=mysql+pymysql://root:@localhost:3306/CCCS105

# OAuth Configuration (Optional - Required for Social Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://127.0.0.1:5000/auth/oauth/callback/google

# Mail Configuration (Required for Password Recovery)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
